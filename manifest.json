{
  "manifest_version": 3,
  "name": "ContextLens",
  "version": "0.1.0",
  "description": "Select text on any page to explain, summarize, or rewrite it with AI.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["dist/content.js"], "run_at": "document_idle" }
  ]
}
